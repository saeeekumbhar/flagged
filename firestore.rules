rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Allow read. Allow write only if they are not touching sensitive fields.
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId 
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['xp', 'coins', 'level', 'flagScore', 'streak', 'bestStreak']);
      
      match /dailyLogs/{logId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        // Frontend cannot write logs anymore; must use Cloud Function
        allow write: if false;
      }

      match /aiInsights/{insightId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        // Frontend cannot write insights; must use Cloud Function
        allow write: if false;
      }
    }
  }
}
